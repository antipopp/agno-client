{
  "name": "agno-client-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Independent open-source client library for Agno agents",
  "author": "antipopp",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "examples:smoke": "pnpm --filter @antipopp/agno-react-example typecheck && pnpm --filter @antipopp/agno-react-example build && pnpm --filter @antipopp/agno-saas-example typecheck && pnpm --filter @antipopp/agno-saas-example build",
    "dev": "pnpm -r --parallel --filter './packages/*' dev",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "lint": "pnpm ultracite fix",
    "release:check": "node scripts/release-check.mjs",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^2.0.0",
    "shadcn": "^3.5.0",
    "typescript": "^5.3.3",
    "ultracite": "7.0.12",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
